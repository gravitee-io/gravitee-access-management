{
    "extends": "@gravitee/graphene-core/tsconfig",
    "compilerOptions": {
        "types": ["vitest/globals"],
        "target": "ES2020",
        "lib": ["DOM", "DOM.Iterable", "ES2020"],
        "module": "ESNext",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "useDefineForClassFields": true
    },
    "include": ["src"]
}

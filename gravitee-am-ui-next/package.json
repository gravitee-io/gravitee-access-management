{
    "name": "gravitee-am-webui-next",
    "version": "4.14.0-SNAPSHOT",
    "description": "Gravitee.io AM - Console (React)",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "yarn typecheck && rsbuild build",
        "lint": "yarn typecheck && yarn lint:eslint && yarn lint:prettier",
        "lint:eslint": "eslint",
        "lint:eslint:fix": "eslint --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "serve": "rsbuild dev",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@gravitee/graphene-core": "3.23.1",
        "@gravitee/graphene-policy-studio": "file:../spike/vendor/graphene-policy-studio-am-spike.tgz",
        "@monaco-editor/react": "4.7.0",
        "@tanstack/react-query": "5.101.1",
        "@tanstack/react-table": "8.21.3",
        "monaco-editor": "0.50.0",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "react-hook-form": "7.79.0",
        "react-router-dom": "7.18.0"
    },
    "devDependencies": {
        "@eslint/compat": "2.1.0",
        "@fontsource/dm-sans": "5.2.8",
        "@rsbuild/core": "2.1.4",
        "@rsbuild/plugin-react": "1.4.6",
        "@tailwindcss/postcss": "4.3.0",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@types/node": "26.0.1",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "eslint": "10.5.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import-x": "4.17.0",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-unused-imports": "4.4.1",
        "jsdom": "29.1.1",
        "prettier": "3.8.4",
        "tailwindcss": "4.3.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.63.0",
        "vitest": "4.1.9"
    },
    "packageManager": "yarn@4.1.1"

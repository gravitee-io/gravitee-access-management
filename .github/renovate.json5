{
  "extends": ["github>gravitee-io/renovate-config","config:js-app"],
  "circleci": {
    "fileMatch": [
      "(^|/).circleci/config.yml$",
      "(^|/).circleci/workflows.yml$",
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Reads the gbuddy pin (hub: x.y.z) in .ai/manifest.yaml as a version of gbuddy, and looks new versions up on the hub's release pages.",
      "managerFilePatterns": ["/(^|/)\\.ai/manifest\\.yaml$/"],
      "matchStrings": ["(?:^|\\n)hub:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"],
      "depNameTemplate": "@gravitee-io/gbuddy",
      "packageNameTemplate": "gravitee-io/gravitee-ai-foundation",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "gitIgnoredAuthors": ["gbuddy-update@users.noreply.github.com"],
  "packageRules": [
    {
      // Group all angular related packages updates together
      "packagePatterns": [
        "^@angular/*",
        "^@angular-builders/*",
        "^@angular-devkit/*",
        "^@angular-ru/*",
        "^@angular-builders/*",
        "^@angular-devkit/*",
        "^@angular/cli$",
        "^@angular/cdk$",
        "^@angular/cdk-experimental$",
        "^@angular/fire$",
        "^@angular/flex-layout$",
        "^@angular/material",
        "ng-packagr"
      ],
      "groupName": "angular",
      "enabled": false
    },
    {
      // Group all eslint related packages updates together
      "packagePatterns": ["^@typescript-eslint/*", "^eslint*", "^@angular-eslint/*"],
      "groupName": "eslint"
    },
    {
      // Group all Jest related packages updates together
      "packagePatterns": ["@types/jest", "^jest*", "ts-jest", "jest-preset-angular"],
      "groupName": "jest"
    },
    {
      // Group all Storybook packages updates together
      "packagePatterns": ["^@storybook/*"],
      "groupName": "storybook"
    },
    {
      "packageNames": ["typescript", "rxjs", "tslib"],
      "separateMinorPatch": true
    },
    {
      // Disable major upgrades for TypeScript, RxJS and tslib as they are linked to the Angular version
      "packageNames": ["typescript", "rxjs", "tslib"],
      "updateTypes": ["major"],
      "enabled": false
    },
    {
      // Disable minor upgrades for TypeScript it is linked to the Angular version
      "packageNames": ["typescript"],
      "updateTypes": ["minor"],
      "enabled": false
    },
    {
      // Update Gravitee NPM packages
      "matchPackageNames": ["^@gravitee/*"],
      "groupName": "@gravitee/ui",
      "automerge": false
    },
    {
      "description": "The gbuddy pin pull request opens at once, so the update workflow can report on it, and does not wait behind the shared limit on Renovate branches.",
      "matchDepNames": ["@gravitee-io/gbuddy"],
      "prConcurrentLimit": 0,
      "prHourlyLimit": 0,
      "fetchChangeLogs": "off",
      "prBodyDefinitions": { "Package": "`{{{depName}}}`" },
      "prCreation": "immediate",
      "prBodyNotes": [
        "This pull request raises the gbuddy pin. A workflow adds the regenerated AI context files and removes the ones this release no longer generates. Review the rule and skill text that changed. Questions: the Builder Experience team."
      ]
    }
  ]
}
